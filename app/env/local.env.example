# Address
DOMAIN=cliproxy.local

# Database (DATABASE_ROOT_PASSWORD is generated by make setup)
DATABASE_NAME=cliproxy
DATABASE_USER=cliproxy
DATABASE_PASSWORD=change-me-local-password

# Symfony
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-openssl-rand-hex-16
DEFAULT_URI=https://cliproxy.local
# The dashboard's login is admin with this password.
ADMIN_PASSWORD=change-me

# CLIProxyAPI: a development hub with no real accounts, beside prod's 8317. Keys: openssl rand -hex 24.
CLIPROXY_PORT=18317
CLIPROXY_PUBLIC_URL=http://127.0.0.1:18317
CLIPROXY_MANAGEMENT_KEY=change-me-management-key
CLIPROXY_API_KEY=change-me-api-key
