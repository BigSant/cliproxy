# Production: the hub on this computer (setup-server target prod, local:/home/tomas/Projects/runtime/cliproxy/prod).
# Secrets (APP_SECRET, ADMIN_PASSWORD, CLIPROXY_MANAGEMENT_KEY, CLIPROXY_API_KEY, DATABASE_PASSWORD,
# DATABASE_ROOT_PASSWORD) are the repository secrets PROD_<name>, which deploy.yml passes to the deploy; none is
# named here (even an empty value would hide it).
DOMAIN=hub.cliproxy.local
PUBLISH_ADDRESS=127.0.0.1
LOCALHOST_PORT=18327
LOCALHOST_PORT_SSL=18328
DATABASE_NAME=cliproxy
DATABASE_USER=cliproxy

APP_ENV=prod
APP_DEBUG=0
DEFAULT_URI=https://hub.cliproxy.local
SERVICES='cron'
CRON_ALLOWED_IPS=127.0.0.1

# The hub's endpoint for Claude Code and Codex on this computer (or through an SSH tunnel to it).
CLIPROXY_PORT=8317
CLIPROXY_PUBLIC_URL=http://127.0.0.1:8317

PHP_MEMORY=512m
PHP_CPUS=0.5
DATABASE_MEMORY=512m
DATABASE_CPUS=0.5
WEBSERVER_MEMORY=128m
WEBSERVER_CPUS=0.25
PROXY_MEMORY=128m
PROXY_CPUS=0.25
