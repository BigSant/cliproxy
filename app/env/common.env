# Project
PROJECT_NAME=cliproxy
PROFILE=generic
CI_PROVIDER=github

# Versions
PHP_VERSION=8.5
MYSQL_VERSION=8.4

# Services
SERVICES=pma

# Application
# Selected by config/apache/vhost.d/document-root.conf; DOCUMENT_ROOT=public would be appended again on every Apache
# container restart by the shared init.sh (sed on sites.conf).
DOCUMENT_ROOT=/
