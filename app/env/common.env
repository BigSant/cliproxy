# Project
PROJECT_NAME=cliproxy
PROFILE=generic
CI_PROVIDER=github

# Versions
PHP_VERSION=8.5
# PHP 8.5 needs newer pins than the shared defaults (Xdebug 3.1.5, Composer 2.7.6).
XDEBUG_VERSION=3.5.3
COMPOSER_VERSION=2.11.0
MYSQL_VERSION=8.4

# Services
SERVICES='pma cron'

# Application
# Selected by config/apache/vhost.d/document-root.conf; DOCUMENT_ROOT=public would be appended again on every Apache
# container restart by the shared init.sh (sed on sites.conf).
DOCUMENT_ROOT=/
# Symfony and the dashboard read these as real env vars (they win over app/public/.env); values live in env/<env>.env.
APP_ENVIRONMENT="APP_ENV APP_DEBUG APP_SECRET DEFAULT_URI ADMIN_PASSWORD CLIPROXY_MANAGEMENT_KEY CLIPROXY_PUBLIC_URL"

# CLIProxyAPI (compose/base.yaml). A pinned release: a new one is a commit, checked locally first.
CLIPROXY_VERSION=v8.0.61
# A hash of app/config/cliproxy/*: the container's environment changes with it, so a deploy recreates the container
# and the new entrypoint/template take effect. CI (checks.yml, lint) refuses a stale value:
#   (cd app/config/cliproxy && for f in $(ls | sort); do printf '%s\0' "$f"; cat "$f"; printf '\0'; done) | sha256sum | cut -c1-12
CLIPROXY_CONFIG_REV=e03316bcb622

# Doctrine migrations (app/public/migrations, run by config/deploy/after-rsync.sh) migrate the database, not setup's
# guarded SQL migrations; the schema export in database/schema still records every change.
DATABASE_MIGRATIONS=off

# Deploy (setup): the smoke list every prod deploy checks; /_health returns the deployed commit.
DEPLOY_HEALTH_PATHS="/login /_health"
DEPLOY_HEALTH_RELEASE_PATH=/_health
# Secrets beyond setup's own (DATABASE_PASSWORD, DATABASE_ROOT_PASSWORD), set by deploy.yml from repository secrets.
DEPLOY_REQUIRED_VARIABLES="APP_SECRET ADMIN_PASSWORD CLIPROXY_MANAGEMENT_KEY CLIPROXY_API_KEY"
CACHE_CLEAR_COMMAND="php bin/console cache:clear"
