{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}
{% block main_class %}login-page{% endblock %}

{% block body %}
    <form method="post" class="card login-card">
        <div class="brand big"><span class="brand-mark">+</span> CLIProxy hub</div>
        <p class="muted">{{ 'login.tagline'|trans }}</p>
        {% if error %}
            <div class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        <input type="hidden" name="_username" value="admin">
        <label>{{ 'login.password'|trans }}
            <input type="password" name="_password" autocomplete="current-password" required autofocus>
        </label>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="button primary">{{ 'login.submit'|trans }}</button>
    </form>
{% endblock %}
