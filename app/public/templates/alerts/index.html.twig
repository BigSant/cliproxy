{% extends 'base.html.twig' %}

{% block title %}Įspėjimai{% endblock %}

{% block body %}
    <div class="page-head">
        <div class="title-line"><h1>Įspėjimai</h1><span class="muted">{{ open|length }} aktyvūs</span></div>
        <div class="head-actions">
            {% if open|filter(a => a.alertKey == 'traffic:quarantine')|length %}
                <form method="post" action="{{ path('app_alerts_retry') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('alerts') }}">
                    <button class="button">Bandyti karantino failus dar kartą</button>
                </form>
            {% endif %}
            <a class="button" href="{{ path('app_settings') }}#ntfy">Pranešimai į telefoną (ntfy)</a>
        </div>
    </div>
    <section class="card">
        {% for alert in open %}
            <div class="alert-row alert-{{ alert.level }}">
                <span class="tag {{ alert.level == 'error' ? 'tag-bad' : (alert.level == 'warning' ? 'tag-warn' : 'tag-info') }}">{{ {error: 'klaida', warning: 'dėmesio', info: 'žinia'}[alert.level] }}</span>
                <div>
                    <div>{{ alert.message }}</div>
                    <div class="muted small">nuo {{ alert.firstSeenAt|date('m-d H:i') }} · paskutinį kartą {{ alert.lastSeenAt|ago }}{% if alert.notifiedAt %} · išsiųsta į ntfy{% endif %}</div>
                </div>
            </div>
        {% else %}
            <p class="muted">Viskas tvarkoje – aktyvių įspėjimų nėra.</p>
        {% endfor %}
    </section>
    {% if resolved is not empty %}
        <section class="card">
            <h2>Išspręsti</h2>
            {% for alert in resolved %}
                <div class="alert-row is-resolved">
                    <span class="tag">{{ alert.resolvedAt|date('m-d H:i') }}</span>
                    <div><div>{{ alert.message }}</div><div class="muted small">nuo {{ alert.firstSeenAt|date('m-d H:i') }}</div></div>
                </div>
            {% endfor %}
        </section>
    {% endif %}
{% endblock %}
