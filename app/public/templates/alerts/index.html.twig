{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.alerts'|trans }}{% endblock %}

{% block body %}
    <div class="page-head">
        <div class="title-line"><h1>{{ 'nav.alerts'|trans }}</h1><span class="muted">{{ 'alerts.open_count'|trans({'%count%': open|length}) }}</span></div>
        <div class="head-actions">
            {% if open|filter(a => a.alertKey == 'traffic:quarantine')|length %}
                <form method="post" action="{{ path('app_alerts_retry') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('alerts') }}">
                    <button class="button">{{ 'alerts.retry_quarantine'|trans }}</button>
                </form>
            {% endif %}
            {% for key, label in {'usage:broken': ['broken', 'alerts.seen_broken'], 'usage:lost': ['lost', 'alerts.seen_lost']} %}
                {% if open|filter(a => a.alertKey == key)|length %}
                    <form method="post" action="{{ path('app_alerts_seen', {what: label[0]}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('alerts') }}">
                        <button class="button">{{ label[1]|trans }}</button>
                    </form>
                {% endif %}
            {% endfor %}
            <a class="button" href="{{ path('app_settings') }}#ntfy">{{ 'alerts.ntfy'|trans }}</a>
        </div>
    </div>
    <section class="card">
        {% for alert in open %}
            <div class="alert-row alert-{{ alert.level }}">
                <span class="tag {{ alert.level == 'error' ? 'tag-bad' : (alert.level == 'warning' ? 'tag-warn' : 'tag-info') }}">{{ ('alerts.level.' ~ alert.level)|trans }}</span>
                <div>
                    <div>{{ alert|alert_message }}</div>
                    <div class="muted small">{{ 'alerts.seen'|trans({'%since%': alert.firstSeenAt|date('m-d H:i'), '%ago%': alert.lastSeenAt|ago}) }}{% if alert.notifiedAt %}{{ 'alerts.sent'|trans }}{% endif %}</div>
                </div>
            </div>
        {% else %}
            <p class="muted">{{ 'alerts.none'|trans }}</p>
        {% endfor %}
    </section>
    {% if resolved is not empty %}
        <section class="card">
            <h2>{{ 'alerts.resolved'|trans }}</h2>
            {% for alert in resolved %}
                <div class="alert-row is-resolved">
                    <span class="tag">{{ alert.resolvedAt|date('m-d H:i') }}</span>
                    <div><div>{{ alert|alert_message }}</div><div class="muted small">{{ 'common.since'|trans({'%time%': alert.firstSeenAt|date('m-d H:i')}) }}</div></div>
                </div>
            {% endfor %}
        </section>
    {% endif %}
{% endblock %}
