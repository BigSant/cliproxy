{% import '_parts/icons.html.twig' as ui %}
<!DOCTYPE html>
<html lang="lt" data-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Hub{% endblock %} · CLIProxy hub</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%228%22 fill=%22%23d97757%22/><path d=%22M9 16h14M16 9v14%22 stroke=%22white%22 stroke-width=%223%22 stroke-linecap=%22round%22/></svg>">
        <script>try { document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark'; if (localStorage.getItem('showEmails') === '1') document.documentElement.classList.add('show-emails'); } catch (e) {}</script>
        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body>
        {% if app.user %}
            {% set route = app.request.attributes.get('_route') %}
            <div class="shell">
                <aside class="sidebar" id="sidebar">
                    <a class="brand" href="{{ path('app_dashboard') }}"><span class="brand-mark">+</span> CLIProxy hub</a>
                    <nav>
                        <a href="{{ path('app_dashboard') }}" class="{{ route == 'app_dashboard' ? 'active' }}">{{ ui.icon('dashboard') }} Apžvalga</a>
                        <a href="{{ path('app_quota') }}" class="{{ route == 'app_quota' ? 'active' }}">{{ ui.icon('quota') }} Kvotos</a>
                        <a href="{{ path('app_accounts') }}" class="{{ route starts with 'app_accounts' ? 'active' }}">{{ ui.icon('accounts') }} Paskyros</a>
                        <a href="{{ path('app_usage') }}" class="{{ route == 'app_usage' ? 'active' }}">{{ ui.icon('usage') }} Naudojimas</a>
                        <div class="nav-group">Srautas</div>
                        <a href="{{ path('app_traffic') }}" class="{{ route in ['app_traffic', 'app_traffic_show'] ? 'active' }}">{{ ui.icon('traffic') }} Žurnalas</a>
                        <a href="{{ path('app_traffic_sessions') }}" class="{{ route in ['app_traffic_sessions', 'app_traffic_session'] ? 'active' }}">{{ ui.icon('sessions') }} Sesijos</a>
                        <a href="{{ path('app_traffic_analysis') }}" class="{{ route == 'app_traffic_analysis' ? 'active' }}">{{ ui.icon('analysis') }} Analizė</a>
                        <div class="nav-group">Hub'as</div>
                        <a href="{{ path('app_settings') }}" class="{{ route == 'app_settings' ? 'active' }}">{{ ui.icon('settings') }} Nustatymai</a>
                        <a href="{{ path('app_connect') }}" class="{{ route == 'app_connect' ? 'active' }}">{{ ui.icon('connect') }} Prijungimas</a>
                        {% set hub = hub_status() %}
                        <a href="{{ path('app_alerts') }}" class="{{ route == 'app_alerts' ? 'active' }}">{{ ui.icon('alert') }} Įspėjimai{% if hub.errors + hub.warnings > 0 %}<span class="nav-badge {{ hub.errors == 0 ? 'warn' }}">{{ hub.errors + hub.warnings }}</span>{% endif %}</a>
                    </nav>
                    <div class="sidebar-foot">
                        <span>CLIProxyAPI {{ hub.version ?? '–' }}</span>
                        {% if hub.latest %}<a class="update" href="{{ path('app_alerts') }}">yra {{ hub.latest }}</a>{% endif %}
                        <span class="{{ hub.collectorStale ? 'bad' }}">kolektorius {{ hub.collectorSeen|ago }}</span>
                    </div>
                </aside>
                <div class="content">
                    <header class="topbar">
                        <button type="button" class="icon-button menu-button" data-toggle-sidebar title="Meniu">{{ ui.icon('menu') }}</button>
                        <div class="topbar-title">{{ block('title') }}</div>
                        <div class="topbar-actions">
                            <button type="button" class="icon-button" data-reload title="Atnaujinti">{{ ui.icon('refresh') }}</button>
                            <button type="button" class="icon-button" data-toggle-emails title="Rodyti / slėpti el. paštus">{{ ui.icon('eye') }}</button>
                            <button type="button" class="icon-button" data-toggle-theme title="Šviesi / tamsi tema">{{ ui.icon('theme') }}</button>
                            <form method="post" action="{{ path('app_logout') }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                <button type="submit" class="icon-button" title="Atsijungti">{{ ui.icon('logout') }}</button>
                            </form>
                        </div>
                    </header>
                    <main class="{% block main_class %}page{% endblock %}">
                        {% if hub.collectorStale %}
                            <div class="flash flash-error banner" role="alert"><strong>Kolektorius neveikia</strong> (paskutinis paleidimas {{ hub.collectorSeen|ago }}): usage, žurnalas ir limitai nesirenka. Tikrink cron konteinerį (<code>docker logs cliproxy-&lt;env&gt;-cron</code>).</div>
                        {% elseif hub.collectorError %}
                            <div class="flash flash-notice" role="status"><strong>Kolektoriaus klaida:</strong> {{ hub.collectorError }}</div>
                        {% endif %}
                        {% include '_parts/flashes.html.twig' %}
                        {% block body %}{% endblock %}
                    </main>
                </div>
            </div>
        {% else %}
            <main class="{{ block('main_class') }}">
                {% include '_parts/flashes.html.twig' %}
                {{ block('body') }}
            </main>
        {% endif %}
    </body>
</html>
