<!DOCTYPE html>
<html lang="lt">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Hub{% endblock %} · CLIProxy hub</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%228%22 fill=%22%23d97757%22/><path d=%22M9 16h14M16 9v14%22 stroke=%22white%22 stroke-width=%223%22 stroke-linecap=%22round%22/></svg>">
        {% block javascripts %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body>
        {% if app.user %}
            <header class="topbar">
                <a class="brand" href="{{ path('app_dashboard') }}"><span class="brand-mark">+</span> CLIProxy hub</a>
                <nav>
                    {% set route = app.request.attributes.get('_route') %}
                    <a href="{{ path('app_dashboard') }}" class="{{ route == 'app_dashboard' ? 'active' }}">Apžvalga</a>
                    <a href="{{ path('app_accounts') }}" class="{{ route starts with 'app_accounts' ? 'active' }}">Paskyros</a>
                    <a href="{{ path('app_usage') }}" class="{{ route == 'app_usage' ? 'active' }}">Naudojimas</a>
                    <a href="{{ path('app_settings') }}" class="{{ route == 'app_settings' ? 'active' }}">Nustatymai</a>
                    <a href="{{ path('app_connect') }}" class="{{ route == 'app_connect' ? 'active' }}">Prijungimas</a>
                </nav>
                <form method="post" action="{{ path('app_logout') }}" class="logout">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="link">Atsijungti</button>
                </form>
            </header>
        {% endif %}
        <main class="{% block main_class %}page{% endblock %}">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% if error is defined and error %}
                <div class="flash flash-error" role="alert"><strong>CLIProxyAPI nepasiekiamas.</strong> {{ error }}</div>
            {% endif %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
