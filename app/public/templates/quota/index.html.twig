{% extends 'base.html.twig' %}
{% import '_parts/icons.html.twig' as ui %}

{% block title %}Kvotos{% endblock %}

{% macro q(params, over) %}{{ path('app_quota', params|merge(over)) }}{% endmacro %}
{% set params = {provider: provider, view: view, burn: burn, window: window, shift: shift} %}

{% block body %}
    <div class="page-head">
        <div class="title-line">
            <h1>Kvotų valdymas</h1>
            <span class="muted">{{ total }} paskyros · limitai perskaityti {{ quotaRefreshedAt|ago|trim('.', 'right') }}.</span>
        </div>
        <form method="post" action="{{ path('app_accounts_quotas') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('accounts') }}">
            <input type="hidden" name="back" value="quota">
            <button class="button primary">{{ ui.icon('refresh') }} Perskaityti visas paskyras</button>
        </form>
    </div>

    <nav class="tabs">
        <a href="{{ _self.q(params, {provider: 'all'}) }}" class="{{ provider == 'all' ? 'active' }}">Visos <span class="count">{{ total }}</span></a>
        {% for key, label in constant('App\\Controller\\QuotaController::PROVIDERS') %}
            <a href="{{ _self.q(params, {provider: key}) }}" class="{{ provider == key ? 'active' }}"><span class="provider-dot provider-{{ key }}"></span>{{ label }} <span class="count">{{ counts[key] }}</span></a>
        {% endfor %}
    </nav>

    <div class="toolbar">
        <div class="segmented">
            {% for key, label in constant('App\\Controller\\QuotaController::VIEWS') %}
                <a href="{{ _self.q(params, {view: key}) }}" class="{{ view == key ? 'active' }}">{{ label }}</a>
            {% endfor %}
        </div>
        <span class="toolbar-label">Langas</span>
        <div class="segmented">
            {% for key, label in constant('App\\Controller\\QuotaController::WINDOW_LABELS') %}
                <a href="{{ _self.q(params, {window: key}) }}" class="{{ window == key ? 'active' }}">{{ label }}</a>
            {% endfor %}
        </div>
        <span class="toolbar-label">Burn rate</span>
        <div class="segmented">
            {% for hours in constant('App\\Controller\\QuotaController::BURN') %}
                <a href="{{ _self.q(params, {burn: hours}) }}" class="{{ burn == hours ? 'active' }}">{{ hours }} val.</a>
            {% endfor %}
        </div>
        <div class="range-nav">
            <span class="muted">{{ from|date('m-d') }} – {{ to|date('m-d') }}</span>
            <a class="icon-button" href="{{ _self.q(params, {shift: shift - 1}) }}" title="Savaitė atgal">{{ ui.icon('chevronLeft') }}</a>
            <a class="button {{ shift == 0 ? 'active' }}" href="{{ _self.q(params, {shift: 0}) }}">Šiandien</a>
            <a class="icon-button" href="{{ _self.q(params, {shift: shift + 1}) }}" title="Savaitė pirmyn">{{ ui.icon('chevronRight') }}</a>
        </div>
    </div>

    {% for card in cards %}
        {% set f = card.forecast %}
        <section class="card pool-card">
            <div class="pool-head">
                <div>
                    <div class="pool-title"><span class="provider-dot provider-{{ card.key }}"></span>{{ card.label }} <span class="muted">{{ card.accounts }} paskyros · {{ constant('App\\Controller\\QuotaController::WINDOW_LABELS')[card.window] }} langas</span></div>
                    {% if f.poolMax > 0 %}
                        <div class="pool-value">{{ f.poolNow|number_format(0) }}%<span class="muted"> iš {{ f.poolMax|number_format(0) }}%</span></div>
                    {% else %}
                        <div class="pool-value muted">–</div>
                    {% endif %}
                </div>
                <dl class="pool-stats">
                    <div><dt>Pool ištuštės</dt><dd>{% if f.poolEmptyAt %}{{ f.poolEmptyAt|when }}{% elseif f.burn > 0 %}ne iki {{ to|date('m-d') }}{% else %}–{% endif %}</dd></div>
                    <div><dt>Pirma ištuštės</dt><dd>{% if f.firstEmpty %}<span class="email">{{ f.firstEmpty.label }}</span> {{ f.firstEmpty.t|until }}{% else %}–{% endif %}</dd></div>
                    <div><dt>Kitas atsinaujinimas</dt><dd>{% if f.nextReset %}+{{ f.nextReset.gain|number_format(0) }}% {{ f.nextReset.t|when }}{% else %}–{% endif %}</dd></div>
                    <div><dt>Burn, {{ burn }} val.</dt><dd>{{ f.burn|number_format(1, ',') }}%/val.</dd></div>
                </dl>
            </div>
            {% if f.poolMax > 0 %}
                {% include '_parts/time_chart.html.twig' with {chart: card.chart, id: card.key, label: card.label ~ ' pool'} %}
                <div class="legend">
                    {% if view == 'remaining' %}
                        <span>Pool</span>
                        <span><i class="line" style="--c: {{ constant('App\\Controller\\QuotaController::COLORS')[card.key] }}"></i> Užfiksuota</span>
                        <span><i class="line dashed" style="--c: {{ constant('App\\Controller\\QuotaController::COLORS')[card.key] }}"></i> Prognozė</span>
                    {% elseif view == 'drain' %}
                        <span>Sąnaudos per valandą (visų paskyrų suma)</span>
                    {% else %}
                        {% for series in card.chart.series|filter(s => not s.dashed) %}
                            <span><i class="line" style="--c: {{ series.color }}"></i> <span class="email">{{ series.label }}</span></span>
                        {% endfor %}
                        <span class="muted">punktyras – prognozė</span>
                    {% endif %}
                </div>
                {% if f.unknown %}<p class="muted small">{{ f.unknown }} paskyrų šio lango limitų dar nėra – jos nevertinamos.</p>{% endif %}
            {% else %}
                <p class="muted">Šio lango limitų dar nėra. Jie atsiras, kai kolektorius perskaitys paskyras (kas kelias minutes).</p>
            {% endif %}
        </section>
    {% else %}
        <section class="card empty">
            <p>Paskyrų dar nėra.</p>
            <a class="button primary" href="{{ path('app_accounts') }}">Prijungti paskyrą</a>
        </section>
    {% endfor %}
{% endblock %}
