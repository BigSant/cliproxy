{% extends 'base.html.twig' %}

{% block title %}Nustatymai{% endblock %}

{% block body %}
    <h1>Nustatymai</h1>
    <div class="grid-2">
        <section class="card">
            <h2>Maršrutizavimas</h2>
            <form method="post" action="{{ path('app_settings_routing') }}" class="stack">
                <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
                <label>Strategija
                    <select name="strategy">
                        {% for key, label in strategies %}<option value="{{ key }}" {{ key == strategy ? 'selected' }}>{{ label }}</option>{% endfor %}
                    </select>
                </label>
                <label class="check"><input type="checkbox" name="affinity" value="1" {{ affinity ? 'checked' }}> Session affinity – sesija lieka savo paskyroje (cache priklauso paskyrai)</label>
                <label>Affinity TTL <input type="text" name="affinity_ttl" value="{{ affinityTtl }}" pattern="\d+(s|m|h)" required></label>
                <label>Pakartojimai nepavykus <input type="number" name="request_retry" value="{{ requestRetry }}" min="0" max="10"></label>
                {% if not usageEnabled %}<p class="bad small">Usage statistika CLIProxyAPI išjungta – išsaugojus įsijungs.</p>{% endif %}
                <button class="button primary">Išsaugoti</button>
            </form>
        </section>

        <section class="card">
            <h2>Soonest-reset-first</h2>
            <p class="muted">CLIProxyAPI pirmiau naudoja didesnio prioriteto paskyras. Įjungus, hub'as po kiekvieno limitų skaitymo
                didžiausią prioritetą duoda paskyrai, kurios savaitinis limitas atsinaujina anksčiausiai (jos tokenai kitaip pradingtų),
                o išnaudotoms – 0. Rankiniai prioritetai tada perrašomi.</p>
            <form method="post" action="{{ path('app_settings_dashboard') }}" class="stack">
                <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
                <label class="check"><input type="checkbox" name="auto_priority" value="1" {{ autoPriority ? 'checked' }}> Įjungti soonest-reset-first</label>
                <label>Limitus skaityti kas (min.) <input type="number" name="refresh_minutes" value="{{ refreshMinutes }}" min="1" max="60"></label>
                <button class="button primary">Išsaugoti</button>
            </form>
        </section>
    </div>

    <section class="card" id="ntfy">
        <h2>Pranešimai į telefoną</h2>
        <p class="muted"><a href="{{ path('app_alerts') }}">Įspėjimai</a> (reikia prisijungti iš naujo, nėra laisvos paskyros, CLIProxyAPI neatsako, baigiasi vieta diske)
            siunčiami per <a href="https://ntfy.sh" target="_blank" rel="noopener noreferrer">ntfy</a>: įdiek programėlę, užsiprenumeruok sunkiai atspėjamą temą ir įrašyk jos adresą.</p>
        <form method="post" action="{{ path('app_settings_ntfy') }}" class="inline-form">
            <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
            <input type="url" name="ntfy_url" value="{{ ntfyUrl }}" placeholder="https://ntfy.sh/cliproxy-hub-…">
            <button class="button primary">Išsaugoti</button>
        </form>
    </section>

    <section class="card">
        <h2>Srauto žurnalas</h2>
        <p class="muted">Kiekviena užklausa ir atsakymas (prompt'as, mąstymas, atsakymas, įrankių kvietimai ir jų rezultatai, tokenai, būsena)
            patenka į <a href="{{ path('app_traffic') }}">Žurnalą</a>, žalias CLIProxyAPI log'as – suspaustas į archyvą. Niekas automatiškai netrinama.
            Juose – visas tavo kodas ir pokalbiai: jie lieka tik šiame kompiuteryje.</p>
        <form method="post" action="{{ path('app_settings_traffic') }}" class="stack">
            <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
            <label class="check"><input type="checkbox" name="request_log" value="1" {{ requestLog ? 'checked' }}> Registruoti visą srautą (CLIProxyAPI <code>request-log</code>)</label>
            <button class="button primary">Išsaugoti</button>
        </form>
    </section>

    <section class="card">
        <div class="card-head">
            <div>
                <h2>Klientų raktai</h2>
                <p class="muted">Juos siunčia Claude Code (<code>ANTHROPIC_AUTH_TOKEN</code>) ir Codex (<code>experimental_bearer_token</code>).</p>
            </div>
            <form method="post" action="{{ path('app_settings_keys_add') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
                <button class="button">+ Naujas raktas</button>
            </form>
        </div>
        <table>
            <tbody>
                {% for key in keys %}
                    <tr>
                        <td><code class="secret" data-secret="{{ key }}">{{ key|slice(0, 6) }}…{{ key|slice(-4) }}</code></td>
                        <td class="actions-cell">
                            <button type="button" class="button small" data-reveal>Rodyti</button>
                            <button type="button" class="button small" data-copy="{{ key }}">Kopijuoti</button>
                            <form method="post" action="{{ path('app_settings_keys_delete') }}" data-confirm="Ištrinti raktą? Jį naudojantys kompiuteriai nebegalės jungtis.">
                                <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
                                <input type="hidden" name="key" value="{{ key }}">
                                <button class="button small danger">Ištrinti</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td class="bad">Raktų nėra – hub'as priima bet kokią užklausą.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    <section class="card">
        <h2>config.yaml</h2>
        <p class="muted">Visa CLIProxyAPI konfigūracija. Pakeitimai įsigalioja iš karto (CLIProxyAPI perkrauna failą pats).</p>
        <form method="post" action="{{ path('app_settings_yaml') }}" class="stack" data-confirm="Išsaugoti config.yaml? Klaida jame gali sustabdyti proxy.">
            <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
            <input type="hidden" name="etag" value="{{ etag }}">
            <textarea name="yaml" rows="24" spellcheck="false" class="code">{{ yaml }}</textarea>
            <p class="muted small">Klientų raktai rodomi kaip <code>&lt;raktas-N&gt;</code>; saugant grąžinami tikri. Jei failas pasikeitė, kol redagavai, išsaugojimas atmetamas.</p>
            <button class="button">Išsaugoti config.yaml</button>
        </form>
    </section>
{% endblock %}
