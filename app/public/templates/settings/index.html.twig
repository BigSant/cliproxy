{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.settings'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'nav.settings'|trans }}</h1>
    <div class="grid-2">
        <section class="card">
            <h2>{{ 'settings.routing'|trans }}</h2>
            <form method="post" action="{{ path('app_settings_routing') }}" class="stack">
                <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
                <label>{{ 'settings.strategy_label'|trans }}
                    <select name="strategy">
                        {% for key, label in strategies %}<option value="{{ key }}" {{ key == strategy ? 'selected' }}>{{ label|trans }}</option>{% endfor %}
                    </select>
                </label>
                <label class="check"><input type="checkbox" name="affinity" value="1" {{ affinity ? 'checked' }}> {{ 'settings.affinity'|trans }}</label>
                <label>Affinity TTL <input type="text" name="affinity_ttl" value="{{ affinityTtl }}" pattern="\d+(s|m|h)" required></label>
                <label>{{ 'settings.retries'|trans }} <input type="number" name="request_retry" value="{{ requestRetry }}" min="0" max="10"></label>
                {% if not usageEnabled %}<p class="bad small">{{ 'settings.usage_off'|trans }}</p>{% endif %}
                <button class="button primary">{{ 'common.save'|trans }}</button>
            </form>
        </section>

        <section class="card">
            <h2>Soonest-reset-first</h2>
            <p class="muted">{{ 'settings.auto_priority_explain'|trans }}</p>
            <form method="post" action="{{ path('app_settings_dashboard') }}" class="stack">
                <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
                <label class="check"><input type="checkbox" name="auto_priority" value="1" {{ autoPriority ? 'checked' }}> {{ 'settings.auto_priority'|trans }}</label>
                <label>{{ 'settings.refresh_minutes'|trans }} <input type="number" name="refresh_minutes" value="{{ refreshMinutes }}" min="1" max="60"></label>
                <button class="button primary">{{ 'common.save'|trans }}</button>
            </form>
        </section>
    </div>

    <section class="card" id="ntfy">
        <h2>{{ 'settings.ntfy'|trans }}</h2>
        <p class="muted">{{ 'settings.ntfy_explain_html'|trans({'%alerts_url%': path('app_alerts')|e})|raw }}</p>
        <form method="post" action="{{ path('app_settings_ntfy') }}" class="inline-form">
            <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
            <input type="url" name="ntfy_url" value="{{ ntfyUrl }}" placeholder="https://ntfy.sh/cliproxy-hub-…">
            <button class="button primary">{{ 'common.save'|trans }}</button>
        </form>
    </section>

    <section class="card">
        <h2>{{ 'settings.traffic'|trans }}</h2>
        <p class="muted">{{ 'settings.traffic_explain_html'|trans({'%journal_url%': path('app_traffic')|e})|raw }}</p>
        <form method="post" action="{{ path('app_settings_traffic') }}" class="stack">
            <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
            <label class="check"><input type="checkbox" name="request_log" value="1" {{ requestLog ? 'checked' }}> {{ 'settings.request_log_html'|trans|raw }}</label>
            <button class="button primary">{{ 'common.save'|trans }}</button>
        </form>
    </section>

    <section class="card">
        <div class="card-head">
            <div>
                <h2>{{ 'settings.keys'|trans }}</h2>
                <p class="muted">{{ 'settings.keys_explain_html'|trans|raw }}</p>
            </div>
            <form method="post" action="{{ path('app_settings_keys_add') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
                <button class="button">{{ 'settings.new_key'|trans }}</button>
            </form>
        </div>
        <table>
            <tbody>
                {% for key in keys %}
                    <tr>
                        <td><code class="secret" data-secret="{{ key }}">{{ key|slice(0, 6) }}…{{ key|slice(-4) }}</code></td>
                        <td class="actions-cell">
                            <button type="button" class="button small" data-reveal>{{ 'settings.reveal'|trans }}</button>
                            <button type="button" class="button small" data-copy="{{ key }}">{{ 'common.copy'|trans }}</button>
                            <form method="post" action="{{ path('app_settings_keys_delete') }}" data-confirm="{{ 'settings.delete_key_confirm'|trans }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
                                <input type="hidden" name="key" value="{{ key }}">
                                <button class="button small danger">{{ 'settings.delete_key'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td class="bad">{{ 'settings.no_keys'|trans }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </section>

    <section class="card">
        <h2>config.yaml</h2>
        <p class="muted">{{ 'settings.yaml_explain'|trans }}</p>
        <form method="post" action="{{ path('app_settings_yaml') }}" class="stack" data-confirm="{{ 'settings.yaml_confirm'|trans }}">
            <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
            <input type="hidden" name="etag" value="{{ etag }}">
            <textarea name="yaml" rows="24" spellcheck="false" class="code">{{ yaml }}</textarea>
            <p class="muted small">{{ 'settings.yaml_note_html'|trans|raw }}</p>
            <button class="button">{{ 'settings.yaml_save'|trans }}</button>
        </form>
    </section>
{% endblock %}
