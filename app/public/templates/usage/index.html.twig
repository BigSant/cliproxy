{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.usage'|trans }}{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ 'nav.usage'|trans }}</h1>
        <nav class="segmented">
            {% for key, item in ranges %}
                <a href="{{ path('app_usage', {range: key}) }}" class="{{ key == range ? 'active' }}">{{ item[1]|trans }}</a>
            {% endfor %}
        </nav>
    </div>

    <section class="stats">
        <div class="stat"><div class="stat-label">{{ 'common.requests'|trans }}</div><div class="stat-value">{{ totals.requests|tokens }}</div><div class="stat-sub">{{ 'common.failed_share'|trans({'%count%': totals.failed, '%share%': totals.failed|share(totals.requests)}) }}</div></div>
        <div class="stat"><div class="stat-label">{{ 'common.tokens'|trans }}</div><div class="stat-value">{{ totals.total|tokens }}</div><div class="stat-sub">{{ 'common.input_output'|trans({'%input%': totals.input|tokens, '%output%': totals.output|tokens}) }}</div></div>
        <div class="stat"><div class="stat-label">{{ 'usage.cache_reads'|trans }}</div><div class="stat-value">{{ totals.cache_read|tokens }}</div><div class="stat-sub">{{ 'usage.of_input'|trans({'%share%': totals.cache_read|share(totals.cache_read + totals.cache_creation + totals.input)}) }}</div></div>
        <div class="stat {{ totals.cache_creation > totals.cache_read ? 'stat-warn' }}"><div class="stat-label">{{ 'usage.cache_writes'|trans }}</div><div class="stat-value">{{ totals.cache_creation|tokens }}</div><div class="stat-sub">{{ (totals.cache_creation > totals.cache_read ? 'usage.writes_exceed' : 'usage.writes_fine')|trans }}</div></div>
        {% include '_parts/cache_ttl_stat.html.twig' %}
    </section>

    <section class="card">
        <h2>{{ 'usage.per_day'|trans }} <span class="muted small">(UTC)</span></h2>
        {% if days is empty %}
            <p class="muted">{{ 'usage.no_requests'|trans }}</p>
        {% else %}
            <div class="chart" role="img" aria-label="{{ 'usage.chart_label'|trans }}">
                {% for day in days %}
                    <div class="chart-col" title="{{ 'usage.day_title'|trans({'%day%': day.day, '%tokens%': day.total|tokens, '%requests%': day.requests, '%read%': day.cache_read|tokens, '%write%': day.cache_creation|tokens}) }}">
                        <div class="chart-bar" style="height: {{ (day.total / dayMax * 100)|number_format(1, '.') }}%">
                            <span class="chart-cache" style="height: {{ day.total > 0 ? (day.cache_read / day.total * 100)|number_format(1, '.') : 0 }}%"></span>
                        </div>
                        <div class="chart-label">{{ day.day|slice(5) }}</div>
                    </div>
                {% endfor %}
            </div>
            <p class="legend"><span class="swatch swatch-total"></span> {{ 'usage.legend_total'|trans }} <span class="swatch swatch-cache"></span> {{ 'usage.legend_cache'|trans }}</p>
        {% endif %}
    </section>

    <div class="grid-2">
        <section class="card">
            <h2>{{ 'usage.by_account'|trans }}</h2>
            {% include 'usage/_table.html.twig' with {rows: accounts, label: 'account', label_title: 'common.account'|trans} %}
        </section>
        <section class="card">
            <h2>{{ 'usage.by_model'|trans }}</h2>
            {% include 'usage/_table.html.twig' with {rows: models, label: 'model', label_title: 'common.model'|trans} %}
        </section>
    </div>

    <section class="card">
        <h2>Session affinity</h2>
        <p>
            {{ 'usage.affinity.sessions'|trans({'%count%': affinity.sessions}) }} <strong class="{{ affinity.moved > 0 ? 'bad' }}">{{ affinity.moved }}</strong> {{ 'usage.affinity.moved'|trans }}
            {{ 'usage.affinity.explain'|trans }}
        </p>
        {% if affinity.examples is not empty %}
            <table>
                <thead><tr><th>{{ 'common.session'|trans }}</th><th class="num">{{ 'common.accounts'|trans }}</th><th class="num">{{ 'common.requests'|trans }}</th></tr></thead>
                <tbody>
                    {% for example in affinity.examples %}
                        <tr><td><code>{{ example.session_id }}</code></td><td class="num">{{ example.accounts }}</td><td class="num">{{ example.requests }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
{% endblock %}
