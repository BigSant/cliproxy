{% extends 'base.html.twig' %}

{% block title %}Sesija{% endblock %}

{% block body %}
    {% set first = exchanges|first %}
    {% set last = exchanges|last %}
    <div class="page-head">
        <div class="title-line">
            <h1>Sesija</h1>
            <code>{{ sessionId }}</code>
            <span class="muted">{{ first.occurredAt|date('m-d H:i') }} – {{ last.occurredAt|date('H:i') }} · {{ exchanges|length }} užklausos</span>
        </div>
        <a class="button" href="{{ path('app_traffic_export', {session: sessionId, range: '90d'}) }}">JSONL</a>
    </div>
    <ol class="timeline">
        {% for exchange in exchanges %}
            <li class="{{ exchange.promptKind == 'user' ? 'is-prompt' }} {{ exchange.failed ? 'is-failed' }}">
                <div class="timeline-meta">
                    <a href="{{ path('app_traffic_show', {id: exchange.id}) }}">{{ exchange.occurredAt|date('H:i:s') }}</a>
                    {% include 'traffic/_status.html.twig' %}
                    <span class="muted small">{{ exchange.model }}{{ exchange.reasoningEffort ? ' ' ~ exchange.reasoningEffort }} · {{ (exchange.durationMs / 1000)|number_format(1, ',') }} s · {{ exchange.outputTokens|tokens }} išv.</span>
                </div>
                {% if exchange.promptKind == 'user' %}<div class="bubble bubble-user">{{ exchange.prompt|u.truncate(600, '…') }}</div>{% endif %}
                {% if exchange.toolErrorCount %}<div class="bad small">{{ exchange.toolErrorCount }} įrankių rezultatai su klaida</div>{% endif %}
                {% if exchange.thinking %}<div class="bubble bubble-think">{{ exchange.thinking|u.truncate(300, '…') }}</div>{% endif %}
                {% if exchange.answer %}<div class="bubble">{{ exchange.answer|u.truncate(600, '…') }}</div>{% endif %}
                {% if exchange.toolCalls is not empty %}
                    <div class="tool-chips">
                        {% for call in exchange.toolCalls %}
                            <span class="chip {{ call.isError is same as(true) ? 'chip-bad' : (call.isError is same as(false) ? 'chip-ok' : '') }}" title="{{ call.input|u.truncate(300, '…') }}">{{ call.name }}</span>
                        {% endfor %}
                    </div>
                {% endif %}
                {% if exchange.error %}<div class="bad small">{{ exchange.error|u.truncate(300, '…') }}</div>{% endif %}
            </li>
        {% endfor %}
    </ol>
{% endblock %}
