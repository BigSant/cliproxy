{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.analysis'|trans }}{% endblock %}

{% block body %}
    <div class="page-head">
        <div class="title-line"><h1>{{ 'traffic.analysis.title'|trans }}</h1></div>
        {% include 'traffic/_filters.html.twig' %}
    </div>
    <section class="stats">
        <div class="stat"><div class="stat-label">{{ 'common.requests'|trans }}</div><div class="stat-value">{{ totals.requests|tokens }}</div><div class="stat-sub">{{ 'common.failed_share'|trans({'%count%': totals.failed, '%share%': totals.failed|share(totals.requests)}) }}</div></div>
        <div class="stat"><div class="stat-label">{{ 'traffic.analysis.human_prompts'|trans }}</div><div class="stat-value">{{ totals.prompts|tokens }}</div><div class="stat-sub">{{ 'traffic.analysis.prompts_sub'|trans({'%sessions%': totals.sessions, '%ratio%': totals.prompts > 0 ? (totals.requests / totals.prompts)|decimal(1) : '–'}) }}</div></div>
        <div class="stat"><div class="stat-label">{{ 'traffic.analysis.tool_calls'|trans }}</div><div class="stat-value">{{ totals.tool_calls|tokens }}</div><div class="stat-sub">{{ 'traffic.analysis.tool_errors_sub'|trans({'%count%': totals.tool_errors, '%share%': totals.tool_errors|share(totals.tool_calls)}) }}</div></div>
        <div class="stat"><div class="stat-label">{{ 'traffic.analysis.thinking'|trans }}</div><div class="stat-value">{{ totals.with_thinking|share(totals.requests) }}</div><div class="stat-sub">{{ 'traffic.analysis.thinking_sub'|trans({'%tokens%': totals.reasoning|tokens}) }}</div></div>
    </section>

    <div class="grid-2">
        <section class="card">
            <h2>{{ 'common.tools'|trans }}</h2>
            {% if tools is empty %}<p class="muted">{{ 'traffic.analysis.no_tool_calls'|trans }}</p>{% else %}
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>{{ 'traffic.analysis.tool'|trans }}</th><th class="num">{{ 'traffic.analysis.calls'|trans }}</th><th class="num">{{ 'traffic.analysis.succeeded'|trans }}</th><th class="num">{{ 'traffic.analysis.failed'|trans }}</th><th>{{ 'traffic.analysis.error_share'|trans }}</th></tr></thead>
                        <tbody>
                            {% for tool in tools %}
                                {% set rate = tool.failed + tool.succeeded > 0 ? tool.failed / (tool.failed + tool.succeeded) * 100 : 0 %}
                                <tr>
                                    <td><code>{{ tool.name }}</code></td>
                                    <td class="num">{{ tool.calls }}</td>
                                    <td class="num">{{ tool.succeeded }}</td>
                                    <td class="num {{ tool.failed ? 'bad' }}">{{ tool.failed }}</td>
                                    <td><div class="quota quota-{{ rate >= 25 ? 'high' : (rate >= 10 ? 'warn' : 'ok') }}"><div class="quota-line"><span class="quota-value">{{ rate|number_format(0) }}%</span>{% if tool.unknown %}<span class="quota-reset">{{ 'traffic.analysis.unclear'|trans({'%count%': tool.unknown}) }}</span>{% endif %}</div><div class="bar"><span style="width: {{ rate|number_format(0) }}%"></span></div></div></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
        <section class="card">
            <h2>{{ 'traffic.analysis.endings'|trans }}</h2>
            {% set most = max(1, (endings|first).count|default(1)) %}
            {% for ending in endings %}
                <div class="hbar"><span class="hbar-label">{{ ending.label }}</span><span class="hbar-track"><span style="width: {{ (ending.count / most * 100)|number_format(1, '.') }}%"></span></span><span class="num">{{ ending.count }}</span></div>
            {% else %}
                <p class="muted">{{ 'common.no_data_alt'|trans }}</p>
            {% endfor %}
            <p class="muted small">{{ 'traffic.analysis.endings_legend'|trans }}</p>
        </section>
    </div>

    <section class="card">
        <h2>{{ 'traffic.analysis.latest_tool_errors'|trans }}</h2>
        {% for call in failures %}
            <details class="tool-call">
                <summary>
                    <a href="{{ path('app_traffic_show', {id: call.exchange.id}) }}">{{ call.exchange.occurredAt|date('m-d H:i') }}</a>
                    <code>{{ call.name }}</code>
                    <span class="muted small">{{ call.output|u.truncate(140, '…') }}</span>
                </summary>
                <div class="tool-body">
                    <pre class="text-block">{{ call.input }}</pre>
                    <pre class="text-block is-error">{{ call.output }}</pre>
                </div>
            </details>
        {% else %}
            <p class="muted">{{ 'traffic.analysis.no_tool_errors'|trans }}</p>
        {% endfor %}
    </section>
{% endblock %}
