{% extends 'base.html.twig' %}

{% block title %}Sesijos{% endblock %}

{% block body %}
    <div class="page-head">
        <div class="title-line"><h1>Sesijos</h1><span class="muted">{{ sessions|length }}</span></div>
        {% include 'traffic/_filters.html.twig' %}
    </div>
    <section class="card flush">
        <div class="table-wrap">
            <table>
                <thead><tr><th>Pabaiga</th><th>Sesija</th><th>Modelis / paskyra</th><th class="num">Prompt'ai</th><th class="num">Užklausos</th><th class="num">Įrankiai</th><th class="num">Įr. klaidos</th><th class="num">Tokenai</th><th class="num">Cache skait.</th></tr></thead>
                <tbody>
                    {% for s in sessions %}
                        <tr class="row-link" data-href="{{ path('app_traffic_session', {sessionId: s.session_id}) }}">
                            <td class="nowrap">{{ s.ended|date('m-d H:i') }}<div class="muted small">nuo {{ s.started|date('H:i') }}</div></td>
                            <td><a href="{{ path('app_traffic_session', {sessionId: s.session_id}) }}"><code>{{ s.session_id|u.truncate(13, '…') }}</code></a></td>
                            <td><span class="provider provider-{{ s.provider }}">{{ s.model }}</span><div class="muted small email">{{ s.account ?: '–' }}</div></td>
                            <td class="num">{{ s.prompts }}</td>
                            <td class="num">{{ s.requests }}{% if s.failed %} <span class="bad">/ {{ s.failed }}</span>{% endif %}</td>
                            <td class="num">{{ s.tool_calls }}</td>
                            <td class="num {{ s.tool_errors ? 'bad' }}">{{ s.tool_errors }}</td>
                            <td class="num">{{ s.tokens|tokens }}</td>
                            <td class="num">{{ s.cache_read|share(s.cache_read + s.cache_creation) }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="9" class="muted empty">Sesijų nėra.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
