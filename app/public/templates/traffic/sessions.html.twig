{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.sessions'|trans }}{% endblock %}

{% block body %}
    <div class="page-head">
        <div class="title-line"><h1>{{ 'nav.sessions'|trans }}</h1><span class="muted">{{ sessions|length }}</span></div>
        {% include 'traffic/_filters.html.twig' %}
    </div>
    <section class="card flush">
        <div class="table-wrap">
            <table>
                <thead><tr><th>{{ 'traffic.sessions.ended'|trans }}</th><th>{{ 'common.session'|trans }}</th><th>{{ 'common.model_account'|trans }}</th><th class="num">{{ 'traffic.sessions.prompts'|trans }}</th><th class="num">{{ 'common.requests'|trans }}</th><th class="num">{{ 'common.tools'|trans }}</th><th class="num">{{ 'traffic.sessions.tool_errors'|trans }}</th><th class="num">{{ 'common.tokens'|trans }}</th><th class="num">{{ 'common.cache_read'|trans }}</th></tr></thead>
                <tbody>
                    {% for s in sessions %}
                        <tr class="row-link" data-href="{{ path('app_traffic_session', {sessionId: s.session_id}) }}">
                            <td class="nowrap">{{ s.ended|date('m-d H:i') }}<div class="muted small">{{ 'common.since'|trans({'%time%': s.started|date('H:i')}) }}</div></td>
                            <td><a href="{{ path('app_traffic_session', {sessionId: s.session_id}) }}"><code>{{ s.session_id|u.truncate(13, '…') }}</code></a></td>
                            <td><span class="provider provider-{{ s.provider }}">{{ s.model }}</span>{% if s.effort %} <span class="kind kind-effort" title="{{ 'common.reasoning_effort'|trans }}">{{ s.effort }}</span>{% endif %}<div class="muted small email">{{ s.account ?: '–' }}</div></td>
                            <td class="num">{{ s.prompts }}</td>
                            <td class="num">{{ s.requests }}{% if s.failed %} <span class="bad">/ {{ s.failed }}</span>{% endif %}</td>
                            <td class="num">{{ s.tool_calls }}</td>
                            <td class="num {{ s.tool_errors ? 'bad' }}">{{ s.tool_errors }}</td>
                            <td class="num">{{ s.tokens|tokens }}</td>
                            <td class="num">{{ s.cache_read|share(s.cache_read + s.cache_creation) }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="9" class="muted empty">{{ 'traffic.sessions.none'|trans }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
