{% extends 'base.html.twig' %}
{% import '_parts/icons.html.twig' as ui %}

{% block title %}{{ 'traffic.show.title'|trans({'%id%': exchange.id}) }}{% endblock %}

{% block body %}
    <div class="page-head">
        <div class="title-line">
            <h1><span class="provider provider-{{ exchange.provider }}">{{ exchange.model ?: exchange.endpoint }}</span>{% if exchange.reasoningEffort %} <span class="kind kind-effort" title="{{ 'common.reasoning_effort'|trans }}">{{ exchange.reasoningEffort }}</span>{% endif %}</h1>
            {% include 'traffic/_status.html.twig' %}
            <span class="muted">{{ exchange.occurredAt|date('Y-m-d H:i:s') }}</span>
        </div>
        <div class="head-actions">
            {% if exchange.sessionId %}
                {% if previous %}<a class="button" href="{{ path('app_traffic_show', {id: previous.id}) }}">{{ 'traffic.show.previous'|trans }}</a>{% endif %}
                <a class="button" href="{{ path('app_traffic_session', {sessionId: exchange.sessionId}) }}">{{ 'traffic.show.position'|trans({'%position%': position, '%length%': sessionLength}) }}</a>
                {% if next %}<a class="button" href="{{ path('app_traffic_show', {id: next.id}) }}">{{ 'traffic.show.next'|trans }}</a>{% endif %}
            {% endif %}
            {% if exchange.archivePath %}<a class="button" href="{{ path('app_traffic_raw', {id: exchange.id}) }}">{{ ui.icon('download') }} {{ 'traffic.show.raw_log'|trans }}</a>{% endif %}
        </div>
    </div>

    <section class="stats compact">
        <div class="stat"><div class="stat-label">{{ 'traffic.show.input_output'|trans }}</div><div class="stat-value">{{ exchange.inputTokens|tokens }} / {{ exchange.outputTokens|tokens }}</div><div class="stat-sub">{{ 'traffic.show.thinking_tokens'|trans({'%tokens%': exchange.reasoningTokens|tokens}) }}</div></div>
        <div class="stat"><div class="stat-label">{{ 'traffic.show.cache'|trans }}</div><div class="stat-value">{{ exchange.cacheReadTokens|tokens }} / {{ exchange.cacheCreationTokens|tokens }}</div><div class="stat-sub">{{ 'traffic.show.messages'|trans({'%count%': exchange.messageCount}) }}</div></div>
        <div class="stat"><div class="stat-label">{{ 'common.duration'|trans }}</div><div class="stat-value">{{ (exchange.durationMs / 1000)|decimal(1) }} s</div><div class="stat-sub">{{ exchange.stream ? 'stream' : 'traffic.show.single_response'|trans }} · {{ exchange.client ?: '–' }}</div></div>
        <div class="stat"><div class="stat-label">{{ 'common.account'|trans }}</div><div class="stat-value small-value email">{{ exchange.account ?: '–' }}</div><div class="stat-sub">{{ exchange.endpoint }} · HTTP {{ exchange.statusCode ?: '–' }}</div></div>
    </section>

    {% if exchange.error %}
        <div class="flash flash-error"><strong>{{ 'traffic.show.error'|trans }}</strong> {{ exchange.error|exchange_error }}</div>
    {% endif %}

    <section class="card">
        <h2>{{ 'common.input'|trans }} <span class="muted small">{{ exchange.promptKind in ['user', 'agent', 'tool_results', 'none'] ? ('traffic.show.prompt_kind.' ~ exchange.promptKind)|trans : exchange.promptKind }}</span></h2>
        {% if exchange.prompt %}<pre class="text-block">{{ exchange.prompt }}</pre>{% endif %}
        {% if exchange.toolErrorCount %}<p class="bad small">{{ 'traffic.show.tool_errors'|trans({'%count%': exchange.toolErrorCount}) }}</p>{% endif %}
        {% if not exchange.prompt and not exchange.toolErrorCount %}<p class="muted">{{ (exchange.promptKind == 'none' ? 'traffic.show.no_new_input_or_nothing' : 'traffic.show.no_new_input')|trans }}</p>{% endif %}
    </section>

    {% if exchange.thinking %}
        <section class="card">
            <details open>
                <summary><h2>{{ 'traffic.show.thinking'|trans }} <span class="muted small">{{ 'traffic.show.chars'|trans({'%count%': exchange.thinking|length|tokens}) }}</span></h2></summary>
                <pre class="text-block thinking">{{ exchange.thinking }}</pre>
            </details>
        </section>
    {% endif %}

    {% if exchange.answer %}
        <section class="card">
            <h2>{{ 'traffic.show.answer'|trans }}</h2>
            <pre class="text-block">{{ exchange.answer }}</pre>
        </section>
    {% endif %}

    {% if exchange.toolCalls is not empty %}
        <section class="card">
            <h2>{{ 'traffic.show.tool_calls'|trans }} <span class="muted small">{{ exchange.toolCalls|length }}</span></h2>
            {% for call in exchange.toolCalls %}
                <details class="tool-call">
                    <summary>
                        <code>{{ call.name }}</code>
                        {% if not call.answered %}<span class="tag">{{ 'traffic.show.awaiting'|trans }}</span>
                        {% elseif call.isError is same as(true) %}<span class="tag tag-bad">{{ 'common.error'|trans }}</span>
                        {% elseif call.isError is same as(false) %}<span class="tag tag-ok">{{ 'traffic.show.succeeded'|trans }}</span>
                        {% else %}<span class="tag">{{ 'traffic.show.unclear'|trans }}</span>{% endif %}
                        <span class="muted small">{{ call.input|u.truncate(120, '…') }}</span>
                    </summary>
                    <div class="tool-body">
                        <div class="muted small">{{ 'common.input'|trans }}</div>
                        <pre class="text-block">{{ call.input }}</pre>
                        {% if call.answered %}
                            <div class="muted small">{{ 'traffic.show.result'|trans({'%time%': call.answeredAt ? call.answeredAt|date('H:i:s') : ''}) }}</div>
                            <pre class="text-block {{ call.isError ? 'is-error' }}">{{ call.output ?: 'traffic.show.empty'|trans }}</pre>
                        {% endif %}
                    </div>
                </details>
            {% endfor %}
        </section>
    {% endif %}

    <section class="card">
        <h2>{{ 'traffic.show.details'|trans }}</h2>
        <dl class="facts">
            <dt>{{ 'common.session'|trans }}</dt><dd>{% if exchange.sessionId %}<a href="{{ path('app_traffic_session', {sessionId: exchange.sessionId}) }}"><code>{{ exchange.sessionId }}</code></a>{% else %}–{% endif %}</dd>
            <dt>{{ 'traffic.show.kind'|trans }}</dt><dd>{{ exchange.kind in ['main', 'subagent', 'compaction', 'fork'] ? ('traffic.kind.' ~ exchange.kind)|trans : (exchange.kind == 'side' ? 'traffic.kind.side_long'|trans : exchange.kind) }}</dd>
            <dt>{{ 'traffic.show.ending'|trans }}</dt><dd>{{ exchange.stopReason ?: '–' }}</dd>
            <dt>{{ 'traffic.show.system_tools'|trans }}</dt><dd>{{ 'traffic.show.system_tools_value'|trans({'%chars%': exchange.systemChars|tokens, '%tools%': exchange.toolsDeclared}) }}</dd>
            <dt>{{ 'traffic.show.size'|trans }}</dt><dd>{{ 'traffic.show.size_value'|trans({'%request%': exchange.requestBytes|tokens, '%response%': exchange.responseBytes|tokens}) }}</dd>
            <dt>{{ 'traffic.show.log_file'|trans }}</dt><dd><code>{{ exchange.logFile }}</code>{% if not exchange.archivePath %} <span class="muted">{{ 'traffic.show.not_archived'|trans }}</span>{% endif %}</dd>
        </dl>
    </section>
{% endblock %}
