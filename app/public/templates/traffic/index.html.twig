{% extends 'base.html.twig' %}
{% import '_parts/icons.html.twig' as ui %}

{% block title %}{{ 'nav.traffic'|trans }}{% endblock %}

{% block body %}
    <div class="page-head">
        <div class="title-line">
            <h1>{{ 'traffic.journal'|trans }}</h1>
            <span class="muted">{{ 'traffic.requests_count'|trans({'%count%': total}) }}</span>
        </div>
        <div class="head-actions">
            {% include 'traffic/_filters.html.twig' %}
            <a class="button" href="{{ path('app_traffic_export', app.request.query.all) }}">{{ ui.icon('download') }} JSONL</a>
        </div>
    </div>

    <form method="get" class="filter-bar">
        <input type="hidden" name="range" value="{{ range }}">
        <input type="search" name="q" value="{{ filters.q }}" placeholder="{{ 'traffic.search'|trans }}">
        <select name="provider">
            <option value="">{{ 'traffic.all_providers'|trans }}</option>
            {% for key, label in {claude: 'Claude', codex: 'Codex', other: 'traffic.other_providers'|trans} %}<option value="{{ key }}" {{ filters.provider == key ? 'selected' }}>{{ label }}</option>{% endfor %}
        </select>
        <select name="outcome">
            <option value="">{{ 'traffic.all_requests'|trans }}</option>
            {% for key in ['prompt', 'agent', 'failed', 'tool_error', 'thinking'] %}<option value="{{ key }}" {{ filters.outcome == key ? 'selected' }}>{{ ('traffic.outcome.' ~ key)|trans }}</option>{% endfor %}
        </select>
        <select name="kind">
            <option value="">{{ 'traffic.all_kinds'|trans }}</option>
            {% for key in ['main', 'subagent', 'compaction', 'fork', 'side'] %}<option value="{{ key }}" {{ filters.kind == key ? 'selected' }}>{{ ('traffic.kinds.' ~ key)|trans }}</option>{% endfor %}
        </select>
        <input type="text" name="model" value="{{ filters.model }}" placeholder="{{ 'common.model'|trans }}">
        {% if filters.session %}<input type="hidden" name="session" value="{{ filters.session }}">{% endif %}
        <button class="button primary">{{ 'traffic.filter'|trans }}</button>
        {% if filters|filter(v => v)|length %}<a class="button" href="{{ path('app_traffic', {range: range}) }}">{{ 'traffic.clear'|trans }}</a>{% endif %}
    </form>

    <section class="card flush">
        <div class="table-wrap">
            <table class="traffic">
                <thead>
                    <tr><th>{{ 'common.time'|trans }}</th><th>{{ 'common.model_account'|trans }}</th><th>{{ 'traffic.input_answer'|trans }}</th><th class="num">{{ 'common.tools'|trans }}</th><th class="num">{{ 'common.tokens'|trans }}</th><th class="num">{{ 'common.duration'|trans }}</th><th>{{ 'common.status'|trans }}</th></tr>
                </thead>
                <tbody>
                    {% for exchange in exchanges %}
                        <tr class="row-link {{ exchange.failed ? 'is-failed' }}" data-href="{{ path('app_traffic_show', {id: exchange.id}) }}">
                            <td class="nowrap"><a href="{{ path('app_traffic_show', {id: exchange.id}) }}">{{ exchange.occurredAt|date('m-d H:i:s') }}</a></td>
                            <td>
                                <span class="provider provider-{{ exchange.provider }}">{{ exchange.model ?: exchange.endpoint }}</span>{% if exchange.logFile starts with 'live:' %} <span class="kind" title="{{ 'traffic.live_title'|trans }}">{{ 'traffic.live'|trans }}</span>{% endif %}{% if exchange.reasoningEffort %} <span class="kind kind-effort" title="{{ 'common.reasoning_effort'|trans }}">{{ exchange.reasoningEffort }}</span>{% endif %}
                                <div class="muted small email">{{ exchange.account ?: '–' }}</div>
                            </td>
                            <td class="excerpt">
                                {% if exchange.kind != 'main' %}<span class="kind">{{ exchange.kind in ['subagent', 'compaction', 'fork', 'side'] ? ('traffic.kind.' ~ exchange.kind)|trans : exchange.kind }}</span> {% endif %}
                                {% if exchange.promptKind == 'user' %}<span class="kind kind-user">{{ 'traffic.human'|trans }}</span> {{ exchange.prompt|u.truncate(140, '…') }}
                                {% elseif exchange.promptKind == 'agent' %}<span class="kind kind-agent" title="{{ 'traffic.agent_title'|trans }}">{{ 'traffic.agent'|trans }}</span> {{ exchange.prompt|u.truncate(140, '…') }}
                                {% elseif exchange.promptKind == 'tool_results' %}<span class="kind">{{ 'traffic.results'|trans }}{% if exchange.toolErrorCount %} · <span class="bad">{{ 'traffic.errors_short'|trans({'%count%': exchange.toolErrorCount}) }}</span>{% endif %}</span>
                                {% else %}<span class="kind">–</span>{% endif %}
                                <div class="muted small">{% if exchange.hasThinking %}<span class="kind kind-think">{{ 'traffic.thought'|trans }}</span> {% endif %}{{ (exchange.answer ?: exchange.error|exchange_error)|u.truncate(140, '…') }}</div>
                            </td>
                            <td class="num">{{ exchange.toolCallCount ?: '' }}</td>
                            <td class="num">{{ (exchange.inputTokens + exchange.outputTokens + exchange.cacheReadTokens + exchange.cacheCreationTokens)|tokens }}</td>
                            <td class="num">{{ (exchange.durationMs / 1000)|decimal(1) }} s</td>
                            <td>{% include 'traffic/_status.html.twig' %}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="muted empty">{{ 'traffic.empty'|trans }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
    {% if pages > 1 %}
        <nav class="pager">
            {% if page > 1 %}<a class="button" href="{{ path('app_traffic', app.request.query.all|merge({page: page - 1})) }}">{{ 'traffic.newer'|trans }}</a>{% endif %}
            <span class="muted">{{ page }} / {{ pages }}</span>
            {% if page < pages %}<a class="button" href="{{ path('app_traffic', app.request.query.all|merge({page: page + 1})) }}">{{ 'traffic.older'|trans }}</a>{% endif %}
        </nav>
    {% endif %}
{% endblock %}
