#!/bin/sh
# Usage: .github/ci/cliproxy-image <version> <checkout>
# Tries eceasy/cli-proxy-api:<version> before the hub takes it (cliproxy-update.yml): starts it the way
# compose/base.yaml does (the checkout's entrypoint.sh and config.template.yaml on an empty state directory) in a
# throwaway container and waits until the management API answers the hub's key as <version>; then the calls the hub
# makes every minute must answer too. No accounts, no project network, no project data; all of it goes at the end.
set -eu
version=${1:?usage: cliproxy-image <version> <checkout>}
checkout=$(cd -P "${2:?usage: cliproxy-image <version> <checkout>}" && pwd -P)
case "$version" in
    v[0-9]*.[0-9]*.[0-9]*) ;;
    *) echo "Not a release version: $version" >&2; exit 1 ;;
esac
# The bind mount: the checkout's own directory, never a symlink out of it (as .github/ci/checkout-code).
for part in app app/config app/config/cliproxy; do
    if [ -L "$checkout/$part" ] || [ ! -d "$checkout/$part" ]; then
        echo "Refused: $part in the checkout is a symlink or not a directory" >&2
        exit 1
    fi
done
config=$checkout/app/config/cliproxy
image=eceasy/cli-proxy-api:$version
docker pull --quiet "$image" >/dev/null
work=$(mktemp -d)
name=cliproxy-ci-image-$$
key=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
cleanup() {
    docker rm -f "$name" >/dev/null 2>&1 || true
    rm -rf "$work"
}
trap cleanup EXIT
mkdir "$work/state" "$work/traffic"
docker run -d --name "$name" -u "$(id -u):$(id -g)" -e HOME=/tmp -e TZ=Europe/Vilnius \
    -e MANAGEMENT_PASSWORD="$key" -e CLIPROXY_API_KEY="ci-$key" -e CLIPROXY_CONFIG_REV=ci \
    -v "$config:/opt/cliproxy/:ro" -v "$work/state:/CLIProxyAPI/state/" -v "$work/traffic:/CLIProxyAPI/traffic/" \
    -p 127.0.0.1::8317 --entrypoint /bin/sh "$image" /opt/cliproxy/entrypoint.sh >/dev/null
port=$(docker port "$name" 8317/tcp | head -n 1 | sed 's/.*://')
api=http://127.0.0.1:$port/v8/management
answered=
for _ in $(seq 60); do
    headers=$(curl -s -o /dev/null -D - --max-time 3 -H "Authorization: Bearer $key" "$api/config" | tr -d '\r' || true)
    if printf '%s\n' "$headers" | grep -q '^HTTP/[0-9.]* 200'; then
        answered=$(printf '%s\n' "$headers" | sed -n 's/^[Xx]-[Cc][Pp][Aa]-[Vv]ersion: *//p')
        break
    fi
    if [ "$(docker inspect -f '{{.State.Running}}' "$name")" != true ]; then
        break
    fi
    sleep 1
done
if [ -z "$answered" ]; then
    docker logs --tail 40 "$name" >&2 || true
    echo "CLIProxyAPI $version did not answer its management API within 60 s" >&2
    exit 1
fi
if [ "$answered" != "$version" ]; then
    echo "The $image image answers as ${answered:-no version}, not $version" >&2
    exit 1
fi
# What the collector and the dashboard read (src/CliProxy/ManagementClient.php).
for path in /credentials '/observability/usage/queue?count=1' /config.yaml; do
    status=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 -H "Authorization: Bearer $key" "$api$path")
    if [ "$status" != 200 ]; then
        echo "CLIProxyAPI $version answers GET /v8/management$path with $status" >&2
        exit 1
    fi
done
echo "$image answers the hub's management calls"
