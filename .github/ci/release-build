#!/bin/sh
# Usage: .github/ci/release-build <checkout>
# Builds a release of the checked-out commit the way setup's make deploy does, to catch what only breaks there: a
# git archive of app/public, then composer install --no-dev with its scripts (cache:clear in prod) and
# config/deploy/build.sh. Like setup's build container it passes no APP_ENV and no DATABASE_*: the build has no
# database and must not need one. It is the one check that runs Composer scripts, with network as the release build
# does, in a throwaway container that sees only the release copy and no secrets. COMPOSER_IMAGE comes from checks.yml.
set -eu
: "${COMPOSER_IMAGE:?}"
checkout=$(cd -P "${1:?usage: release-build <checkout>}" && pwd -P)
# app/public must really be the checkout's own (checkout-code), or git would archive another repository.
code=$("$(dirname "$0")/checkout-code" "$checkout")
release=$(mktemp -d "${RUNNER_TEMP:-/tmp}/cliproxy-release.XXXXXX")
trap 'rm -rf "$release"' EXIT
git -C "$code" archive --format=tar HEAD | tar -x -C "$release"
if [ "$(cat "$release/config/release.txt")" != "$(git -C "$code" rev-parse HEAD)" ]; then
    echo "config/release.txt does not name the commit: export-subst did not apply" >&2
    exit 1
fi
cp "$checkout/app/config/deploy/build.sh" "$release/.setup-build.sh"
docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e COMPOSER_HOME=/tmp/composer \
    -v "$release:/var/www/html" -w /var/www/html "$COMPOSER_IMAGE" sh -ec '
        composer install --no-dev --optimize-autoloader --no-interaction --no-progress
        sh -e .setup-build.sh
        php bin/console about --env=prod | grep -E "Environment +prod"'
echo "The release builds without a database."
